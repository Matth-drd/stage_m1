%Carloni et ses collaborateurs utilisent plusieurs algorithmes de Machine Learning
%pour prédire les résultats des paris sportifs « Over/Under 2.5 buts ». Les auteurs
%collectent plus de 49 000 matchs dans 12 pays puis sélectionnent les variables les
%plus pertinentes avant d’entraîner différents modèles comme la régression logistique,
%SVM, Random Forest et réseaux de neurones. Le meilleur résultat est obtenu avec un
%réseau de neurones artificiels (ANN), capable d’atteindre une bonne précision et un
%retour sur investissement positif. L’étude montre l’efficacité du Machine Learning
%appliqué aux paris sportifs, mais souligne aussi les limites liées au manque d’interprétabilité
%des réseaux de neurones et à la validation sur un nombre limité de matchs.


@article{maher,
author = {Maher, M. J.},
title = {Modelling association football scores},
journal = {Statistica Neerlandica},
volume = {36},
number = {3},
pages = {109-118},
keywords = {Poisson goals distribution, iterative maximum likelihood},
doi = {https://doi.org/10.1111/j.1467-9574.1982.tb00782.x},
url = {https://onlinelibrary.wiley.com/doi/abs/10.1111/j.1467-9574.1982.tb00782.x},
eprint = {https://onlinelibrary.wiley.com/doi/pdf/10.1111/j.1467-9574.1982.tb00782.x},
abstract = {Abstract  Previous authors have rejected the Poisson model for association football scores in favour of the Negative Binomial. This paper, however, investigates the Poisson model further. Parameters representing the teams' inherent attacking and defensive strengths are incorporated and the most appropriate model is found from a hierarchy of models. Observed and expected frequencies of scores are compared and goodness-of-fit tests show that although there are some small systematic differences, an independent Poisson model gives a reasonably accurate description of football scores. Improvements can be achieved by the use of a bivariate Poisson model with a correlation between scores of 0.2.},
year = {1982}
}


