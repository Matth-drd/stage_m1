@article{dixon,
  title = "Modelling association football scores and inefficiencies in the football betting market.",
  abstract = "A parametric model is developed and fitted to English league and cup football data from 1992 to 1995. The model is motivated by an aim to exploit potential inefficiencies in the association football betting market, and this is examined using bookmakers' odds from 1995 to 1996. The technique is based on a Poisson regression model but is complicated by the data structure and the dynamic nature of teams' performances. Maximum likelihood estimates are shown to be computationally obtainable, and the model is shown to have a positive return when used as the basis of a betting strategy.",
  keywords = "Betting strategy • Expected return • Football (soccer) • Maximum likelihood • Poisson distribution",
  author = "Dixon, {Mark J.} and Coles, {Stuart G.}",
  year = "1997",
  doi = "10.1111/1467-9876.00065",
  language = "English",
  volume = "46",
  pages = "265--280",
  journal = "Journal of the Royal Statistical Society: Series C (Applied Statistics)",
  issn = "0035-9254",
  publisher = "Wiley-Blackwell",
  number = "2",
}
%Dixon et Coles proposent un modèle statistique basé sur les lois de Poisson afin de prédire
%les scores des matchs de football et détecter des opportunités de paris sportifs rentables.
%Leur approche modélise séparément les forces d’attaque et de défense de chaque équipe ainsi
%que l’avantage du terrain. Les auteurs améliorent le modèle classique en introduisant une
%correction de dépendance pour les faibles scores (0-0, 1-0, 1-1, etc.) et une pondération
%temporelle donnant plus d’importance aux matchs récents. Leur modèle est interprétable et
%performant pour les paris sportifs, mais reste limité par l’absence de variables contextuelles
%et par l’hypothèse de Poisson.


@article{egidi,
  author = {Egidi, Leonardo and Torelli, Nicola},
  year = {2021},
  month = {08},
  pages = {},
  title = {Comparing Goal-Based and Result-Based Approaches in Modelling Football Outcomes},
  volume = {156},
  journal = {Social Indicators Research},
  doi = {10.1007/s11205-020-02293-z}
}
%Egidi et Torelli comparent deux approches bayésiennes de
%prédiction des matchs de football lors de la Coupe du Monde
%2018 : les modèles basés sur le résultat final (victoire, nul, défaite) et
%ceux basés sur le nombre de buts marqués. Les modèles utilisent des paramètres
%représentant les forces offensives et défensives des équipes ainsi que leur
%classement FIFA. L’étude montre que les modèles multinomiaux sont plus efficaces
%lorsque les équipes ont un niveau proche, tandis que les modèles de Poisson sont
%meilleurs lorsque l’écart de niveau est important. L’approche bayésienne permet
%également de mesurer l’incertitude des prédictions.

